---
// Placeholder illustration of a bottle lamp. Replace with real photos via `product.photos`.
import type { Product } from '../data/products';
interface Props { art: Product['art']; id: string; class?: string; lit?: boolean }
const { art, id, class: cls = '', lit = true } = Astro.props;
const { shape, glass, light, accent = '#c9a26b', decor } = art;

// Bottle silhouettes in a 200×300 box.
const shapes: Record<string, string> = {
  wine:   'M90 18 h20 v70 c0 22 38 30 38 62 v128 a10 10 0 0 1 -10 10 h-76 a10 10 0 0 1 -10 -10 v-128 c0 -32 38 -40 38 -62 z',
  tall:   'M92 10 h16 v92 c0 18 30 24 30 50 v128 a8 8 0 0 1 -8 8 h-60 a8 8 0 0 1 -8 -8 v-128 c0 -26 30 -32 30 -50 z',
  round:  'M88 40 h24 v40 c40 10 62 50 62 100 c0 60 -36 108 -74 108 c-38 0 -74 -48 -74 -108 c0 -50 22 -90 62 -100 z',
  square: 'M88 36 h24 v38 c0 8 6 12 18 14 h12 a12 12 0 0 1 12 12 v178 a10 10 0 0 1 -10 10 h-88 a10 10 0 0 1 -10 -10 v-178 a12 12 0 0 1 12 -12 h12 c12 -2 18 -6 18 -14 z',
  flask:  'M90 52 h20 v34 c34 6 54 30 54 66 v96 c0 26 -20 40 -64 40 c-44 0 -64 -14 -64 -40 v-96 c0 -36 20 -60 54 -66 z',
};
const neckTop: Record<string, number> = { wine: 18, tall: 10, round: 40, square: 36, flask: 52 };
const top = neckTop[shape];

// Deterministic pseudo-random fairy lights.
let seed = [...id].reduce((a, c) => a + c.charCodeAt(0), 0);
const rnd = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
const dots = Array.from({ length: 26 }, () => ({
  x: 40 + rnd() * 120, y: 130 + rnd() * 150, r: 1.6 + rnd() * 2.4, d: (rnd() * 3).toFixed(2),
}));
const u = `b-${id}`;
---
<svg class={`bottle ${lit ? 'is-lit' : ''} ${cls}`} viewBox="0 0 200 320" role="img" aria-hidden="true">
  <defs>
    <radialGradient id={`${u}-halo`} cx="50%" cy="62%" r="55%">
      <stop offset="0%" stop-color={light} stop-opacity=".55" />
      <stop offset="60%" stop-color={light} stop-opacity=".08" />
      <stop offset="100%" stop-color={light} stop-opacity="0" />
    </radialGradient>
    <linearGradient id={`${u}-glass`} x1="0" x2="1">
      <stop offset="0%" stop-color={glass} stop-opacity=".95" />
      <stop offset="45%" stop-color={glass} stop-opacity=".72" />
      <stop offset="100%" stop-color={glass} stop-opacity=".98" />
    </linearGradient>
    <radialGradient id={`${u}-inner`} cx="50%" cy="65%" r="50%">
      <stop offset="0%" stop-color={light} stop-opacity=".75" />
      <stop offset="100%" stop-color={light} stop-opacity="0" />
    </radialGradient>
    <clipPath id={`${u}-clip`}><path d={shapes[shape]} /></clipPath>
  </defs>

  <ellipse class="halo" cx="100" cy="200" rx="100" ry="120" fill={`url(#${u}-halo)`} />
  <ellipse cx="100" cy="300" rx="70" ry="6" fill="#000" opacity=".25" />

  <path d={shapes[shape]} fill={`url(#${u}-glass)`} />
  <g clip-path={`url(#${u}-clip)`}>
    <rect class="inner" x="0" y="80" width="200" height="240" fill={`url(#${u}-inner)`} />

    {decor === 'tiles' && (
      <g stroke={accent} stroke-width="2.4" fill="none" opacity=".9">
        {Array.from({ length: 6 }).map((_, r) => Array.from({ length: 5 }).map((_, c) => (
          <g transform={`translate(${30 + c * 32} ${110 + r * 32})`}>
            <rect x="0" y="0" width="30" height="30" stroke-width="1" />
            <path d="M15 3 L27 15 L15 27 L3 15 Z" fill={accent} fill-opacity=".35" />
            <circle cx="15" cy="15" r="3.5" fill={accent} />
          </g>
        )))}
      </g>
    )}
    {decor === 'rooftops' && (
      <g fill="#0d0d18">
        <path d="M0 320 V230 l18 -14 l18 14 v-20 h22 v-10 l16 -12 l16 12 v26 l20 -18 l22 16 v-30 h24 v20 l22 -16 l22 16 V320 Z" />
        {[[44,240],[70,232],[96,250],[120,236],[150,226],[168,246],[60,262],[130,262]].map(([x,y]) => (
          <rect class="win" x={x} y={y} width="7" height="9" fill={accent} />
        ))}
      </g>
    )}
    {decor === 'flowers' && (
      <g stroke={accent} stroke-width="2" fill="none">
        <path d="M100 300 C96 250 80 220 70 190 M100 300 C104 240 120 210 132 180 M100 300 C100 250 100 220 98 170" />
        {[[70,188],[132,178],[98,168],[84,214],[118,206]].map(([x,y]) => (
          <circle cx={x} cy={y} r="7" fill="#f1b6c0" stroke="none" />
        ))}
      </g>
    )}
    {decor === 'engrave' && (
      <g fill="none" stroke={accent} stroke-width="1.6" opacity=".9">
        <path d="M100 196 c-10 -14 -30 -4 -18 12 l18 18 l18 -18 c12 -16 -8 -26 -18 -12 z" fill={accent} fill-opacity=".25" />
        <path d="M66 246 h68 M76 256 h48" />
      </g>
    )}
    {decor === 'wire' && (
      <path d="M40 140 C140 160 60 190 160 210 S50 250 150 280" stroke={accent} stroke-width="1.6" fill="none" />
    )}

    {dots.map((d) => (
      <circle class="dot" cx={d.x} cy={d.y} r={d.r} fill={light} style={`animation-delay:${d.d}s`} />
    ))}
    <!-- glass highlight -->
    <rect x="58" y="0" width="10" height="320" fill="#fff" opacity=".12" />
  </g>

  {/* neck decoration */}
  {decor === 'cord' && (
    <g stroke={accent} stroke-width="3" fill="none">
      {[0,1,2,3,4].map((i) => <path d={`M86 ${top + 22 + i * 6} q14 4 28 0`} />)}
    </g>
  )}
  {/* cork */}
  <rect x={shape === 'tall' ? 91 : 88} y={top - 14} width={shape === 'tall' ? 18 : 24} height="18" rx="3" fill="#b88a5a" />
</svg>

<style>
  .bottle { width: 100%; height: 100%; display: block; overflow: visible; }
  .bottle .halo, .bottle .inner, .bottle .dot, .bottle .win { transition: opacity .6s ease; }
  .bottle:not(.is-lit) .halo, .bottle:not(.is-lit) .inner { opacity: 0; }
  .bottle:not(.is-lit) .dot { opacity: .25; }
  .bottle:not(.is-lit) .win { opacity: .3; }
  .bottle.is-lit .dot { animation: twinkle 2.6s ease-in-out infinite; }
  @keyframes twinkle { 0%,100% { opacity: 1 } 50% { opacity: .45 } }
  @media (prefers-reduced-motion: reduce) { .bottle.is-lit .dot { animation: none; } }
</style>
